//@version=5
// EMA 200/300 staggered cross on Heikin Ashi, longs and shorts. Same rules as ema-cross/strategy.js.
// Add to a DAILY chart (normal candles or Heikin Ashi, both work: the script builds Heikin Ashi itself).
// Keep the "Dividend-adjusted" input the same as the chart's ADJ button, or the lines sit off the candles.
// Long: the HA candle broke below both EMAs (part of the HA body under both counts), then the whole HA body
// is above both. Short: the mirror. No signal when the EMAs are flat and have been tangled for 40+ days (see inputs).
// The DeMarker value is written under every candle (the last 500 candles: TradingView's label limit).
indicator("EMA 200/300 HA cross: longs & shorts", overlay = true, max_labels_count = 500)

flatGap = input.float(0.2, "Flat filter: EMA gap under %", step = 0.05) / 100
flatSlope = input.float(2.0, "Flat filter: EMA 200 moved under % in 20 days", step = 0.5) / 100
flatDays = input.int(40, "Flat filter: EMAs tangled for at least N days", minval = 1)

adjDiv = input.bool(true, "Dividend-adjusted prices (set the same as the chart's ADJ button)")
demLen = input.int(14, "DeMarker length", minval = 1)

// Standard candles of this symbol with the chosen adjustment. ticker.standard() would drop the chart's
// dividend adjustment, so the EMAs drifted away from an adjusted chart further back in time.
src = ticker.new(syminfo.prefix, syminfo.ticker, syminfo.session, adjDiv ? adjustment.dividends : adjustment.splits)
[o, h, l, c] = request.security(src, timeframe.period, [open, high, low, close])
// Heikin Ashi built here from those candles, the same way as the website and the Python backtest
hC = (o + h + l + c) / 4
var float hO = na
hO := na(hO[1]) ? (o + c) / 2 : (hO[1] + hC[1]) / 2

e200 = ta.ema(hC, 200)
e300 = ta.ema(hC, 300)
loB = math.min(hO, hC)
hiB = math.max(hO, hC)
side = loB > e200 and loB > e300 ? 1 : hiB < e200 and hiB < e300 ? -1 : 0  // whole body above both / below both
brokeDn = loB < e200 and loB < e300  // part of the body under both lines: arms a long
brokeUp = hiB > e200 and hiB > e300  // part of the body over both lines: arms a short
inGap = math.abs(e200 - e300) / math.min(e200, e300) < flatGap
// tangled today and on every one of the previous flatDays bars, and the EMA 200 flat: chop, not a brief touch
tangled = inGap and math.sum(inGap ? 1 : 0, flatDays)[1] >= flatDays and math.abs(e200 / e200[20] - 1) < flatSlope

var bool armLong = false
var bool armShort = false
fire = (side == 1 and armLong) or (side == -1 and armShort)
if fire and side == 1
    armLong := false
if fire and side == -1
    armShort := false
armLong := armLong or brokeDn
armShort := armShort or brokeUp
sig = bar_index > 300 and fire and not tangled

plot(e200, "EMA 200 (HA close)", color.orange, 2)
plot(e300, "EMA 300 (HA close)", color.purple, 2)
plotshape(sig and side == 1, "Long", shape.triangleup, location.belowbar, color.green, size = size.small)
plotshape(sig and side == -1, "Short", shape.triangledown, location.abovebar, color.red, size = size.small)

// DeMarker (Tom DeMark), on the real candles: DeMax = rise of the high vs the previous high (else 0),
// DeMin = fall of the low vs the previous low (else 0). DeM = SMA(DeMax) / (SMA(DeMax) + SMA(DeMin)), 0 to 1.
// Over 0.7 = overbought (red), under 0.3 = oversold (green).
deMax = h > h[1] ? h - h[1] : 0.0
deMin = l < l[1] ? l[1] - l : 0.0
sMax = ta.sma(deMax, demLen)
sMin = ta.sma(deMin, demLen)
dem = sMax + sMin > 0 ? sMax / (sMax + sMin) : 0.5
demCol = dem > 0.7 ? color.red : dem < 0.3 ? color.lime : color.gray
plot(dem, "DeMarker", demCol, display = display.status_line + display.data_window)
if not na(dem)
    label.new(bar_index, l, str.tostring(dem, "0.00"), yloc = yloc.belowbar, style = label.style_none, textcolor = demCol, size = size.tiny)
